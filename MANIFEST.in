include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml

recursive-include src/dazzlelink *
recursive-include docs *
recursive-include examples *
recursive-include tests *

# Exclude repokit-common subtree internals from sdist
prune scripts/.github
prune scripts/tests
prune scripts/docs
exclude scripts/.gitignore
exclude scripts/.repokit.json
exclude scripts/pyproject.toml.*

global-exclude *.py[cod] __pycache__ *.so *.dylib .DS_Store
